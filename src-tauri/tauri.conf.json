{
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  },
  "productName": "killdozer",
  "mainBinaryName": "killdozer",
  "version": "0.6.7",
  "identifier": "com.wabbit.killdozer",
  "plugins": {},
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Killdozer",
        "width": 1200,
        "height": 700,
        "minWidth": 1200,
        "minHeight": 700,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}