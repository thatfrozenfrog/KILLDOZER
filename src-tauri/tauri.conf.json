{
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  },
  "productName": "killdozer",
  "mainBinaryName": "killdozer",
  "version": "1.0.1",
  "identifier": "com.kiwi.killdozer",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2NUVFQzYzMzk3QTNENzkKUldSNVBYbzVZK3hlaHZTV1NkUnIwdURSeWFGMklvWU4yV1h4ajNrVzZDMHRqWnZ3TUZMUTZwL3QK",
      "endpoints": [
        "https://github.com/thatfrozenfrog/killdozer/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "decorations": false,
        "fullscreen": false,
        "resizable": true,
        "title": "Killdozer",
        "width": 1200,
        "height": 700,
        "minWidth": 1200,
        "minHeight": 700,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
