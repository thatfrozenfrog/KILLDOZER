pkgname=killdozer
pkgver=1.0.0
pkgrel=1
pkgdesc="Killdozer"
arch=('x86_64')
license=('MIT')

depends=(
  'webkit2gtk-4.1'
  'gtk3'
)

source=(
  'killdozer'
  'killdozer.desktop'
  'killdozer.png'
)

sha256sums=(
  'SKIP'
  'SKIP'
  'SKIP'
)

package() {
  install -Dm755 \
    "$srcdir/killdozer" \
    "$pkgdir/usr/bin/killdozer"

  install -Dm644 \
    "$srcdir/killdozer.desktop" \
    "$pkgdir/usr/share/applications/killdozer.desktop"

  install -Dm644 \
    "$srcdir/killdozer.png" \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/killdozer.png"
}